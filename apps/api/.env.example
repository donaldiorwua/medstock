# Copy to .env for local work. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./dev.db
# For local PostgreSQL (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://medstock:medstock@localhost:5432/medstock

# Required (32+ characters) when APP_ENV is staging or production.
SESSION_SECRET=
# Must be true outside local development.
COOKIE_SECURE=false

EXPIRY_WARNING_DAYS=90
STALE_HOURS=72
BACKDATE_DAYS=30
ADJUSTMENT_REVIEW_PERCENT=10
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
